# Environment Variables for PathWise AI

# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local to version control.

# --- Gemini AI (required) ---
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Pinecone Vector Store (optional — only needed for RAG features) ---
# Get yours at: https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=pathwise-ai

# --- Database (auto-configured for SQLite) ---
# SQLite file will be created at prisma/dev.db
DATABASE_URL="file:./dev.db"
